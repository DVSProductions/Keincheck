<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The hub targets net10 but references the net8 Protocol lib; roll forward
         so it runs on the installed .NET 10 runtime. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <!-- Windows-only build knobs. Both are no-ops on a POSIX target — COM interop does not
       exist there and there is no Win32 resource section to stamp an icon into — but keeping
       them scoped documents that, and keeps the linux/osx publishes free of dead properties.
       The Linux/macOS package icons come from the vpk pack icon option (see release.yml). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))">
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Win32 executable icon (shows on the .exe, taskbar, and Velopack shortcut). -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The hub runs Kestrel in-process for the loopback MCP endpoint; it needs the
       ASP.NET Core shared framework. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <!-- The app-id sanitiser is internal (it is a hardening detail, not API) but is worth
       testing directly: it is the only defence against a client-chosen identity reaching the
       registry keys and the AppId@Host disambiguator. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Keincheck.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Tray icon asset (optional; the app runs without it). Embedded as an Avalonia
       resource so AssetLoader can resolve avares://Keincheck.Hub/Assets/tray.ico. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The hub speaks the wire Protocol to clients over the pipe. It does NOT
         reference Core/Avalonia-introspection: tools execute inside each app, and
         the hub advertises the schemas the client reports. -->
    <ProjectReference Include="..\Keincheck.Protocol\Keincheck.Protocol.csproj" />

    <!-- The listener side of remote access: TLS, the hub's CA, and the credential
         format. Keincheck.Remote references ONLY Keincheck.Protocol, so this does not
         drag the client's tool host or the MCP SDK into the hub. Referencing it does
         not by itself open anything: the listener stays off until an operator enables
         it, and cannot accept a session before a CA has been provisioned. -->
    <ProjectReference Include="..\Keincheck.Remote\Keincheck.Remote.csproj" />
  </ItemGroup>

</Project>
