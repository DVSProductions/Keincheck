<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- References the net8 Protocol library from a net10 test host. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
  </ItemGroup>

  <!--
    Keincheck.Protocol ONLY, and deliberately so.

    This suite drives a real, installed Keincheck.Hub.exe as a separate process. It
    needs Protocol for the well-known endpoint names (PipeNames) and the pipe connect
    helper (PipeTransport) that the shim itself uses as its readiness gate — nothing
    more. A ProjectReference to Keincheck.Hub would drop the hub's own assemblies into
    this test's output directory, which is exactly how a future refactor quietly turns
    an out-of-process test back into an in-process one without anybody noticing.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\Keincheck.Protocol\Keincheck.Protocol.csproj" />
  </ItemGroup>

</Project>
