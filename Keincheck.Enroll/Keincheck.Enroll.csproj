<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>keincheck-enroll</AssemblyName>
    <RootNamespace>Keincheck.Enroll</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    A console exe rather than an MSBuild task, deliberately. A task assembly must target
    netstandard2.0 to load in both MSBuild.exe and `dotnet build`, which it cannot do while
    referencing the net8.0 Keincheck.Remote. An exe sidesteps that entirely, is trivially
    runnable by hand for the CI/baked-credential path, and mirrors the existing
    Keincheck.Connect precedent of a small shipped executable.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Keincheck.Protocol\Keincheck.Protocol.csproj" />
    <ProjectReference Include="..\Keincheck.Remote\Keincheck.Remote.csproj" />
  </ItemGroup>

</Project>
